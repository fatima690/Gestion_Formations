<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_formation_participants" model="ir.actions.act_window">
        <field name="name">Participants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="[('category_id', 'in', [ref('Gestion_Form.partner_category_participant')])]"/>
        <field name="context" eval="{'default_is_company': 0, 'default_category_id': [ref('Gestion_Form.partner_category_participant')]}"/>
    </record>

    <menuitem id="menu_formations_participants" 
              name="Participants" 
              parent="menu_gestion_formations" 
              sequence="35"
              action="action_formation_participants"/>
</odoo>
