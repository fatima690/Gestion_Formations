<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_formation_session_tree" model="ir.ui.view">
        <field name="name">gestion.formation.session.tree</field>
        <field name="model">gestion.formation.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="formation_id"/>
                <field name="ville"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="formateur_id"/>
                <field name="capacite"/>
                <field name="seats_taken"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_formation_session_form" model="ir.ui.view">
        <field name="name">gestion.formation.session.form</field>
        <field name="model">gestion.formation.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_draft" type="object" string="Remettre en brouillon" invisible="state != 'cancel' and state != 'done'"/>
                    <button name="action_confirm" type="object" string="Confirmer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Démarrer" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Terminer" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-secondary" invisible="state == 'cancel' or state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done,cancel"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="formation_id"/>
                        <field name="formateur_id"/>
                    </group>
                    <group>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="capacite"/>
                    </group>
                    <group>
                        <field name="seats_taken" readonly="1"/>
                        <field name="seats_available" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Inscriptions">
                            <field name="inscription_ids" context="{'default_session_id': active_id}">
                                <tree editable="bottom">
                                    <field name="participant_id"/>
                                    <field name="date_inscription"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_formation_session_kanban" model="ir.ui.view">
        <field name="name">gestion.formation.session.kanban</field>
        <field name="model">gestion.formation.session</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="formation_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>
                                <field name="formation_id"/>
                            </div>
                            <div>
                                <field name="date_debut"/> - <field name="date_fin"/>
                            </div>
                            <div>
                                <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_formation_session_search" model="ir.ui.view">
        <field name="name">gestion.formation.session.search</field>
        <field name="model">gestion.formation.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="formation_id"/>
                <field name="formateur_id"/>
                <field name="state"/>
                <filter string="Brouillon" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmée" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="En cours" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Terminée" name="done" domain="[('state','=','done')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Formation" name="group_formation" context="{'group_by': 'formation_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Formateur" name="group_formateur" context="{'group_by': 'formateur_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_formation_sessions" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">gestion.formation.session</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <menuitem id="menu_formations_sessions" 
              name="Sessions" 
              parent="menu_gestion_formations" 
              sequence="30"
              action="action_formation_sessions"/>
</odoo>
