<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_formation_inscription_tree" model="ir.ui.view">
        <field name="name">gestion.formation.inscription.tree</field>
        <field name="model">gestion.formation.inscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="formation_id"/>
                <field name="session_id"/>
                <field name="formateur_id"/>
                <field name="participant_id"/>
                <field name="date_inscription"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_formation_inscription_form" model="ir.ui.view">
        <field name="name">gestion.formation.inscription.form</field>
        <field name="model">gestion.formation.inscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object" string="Remettre en brouillon" invisible="state != 'cancel'"/>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-secondary" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancel"/>
                </header>
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="participant_id"/>
                    </group>
                    <group>
                        <field name="date_inscription"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_formation_inscription_search" model="ir.ui.view">
        <field name="name">gestion.formation.inscription.search</field>
        <field name="model">gestion.formation.inscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="participant_id"/>
                <field name="formation_id"/>
                <field name="session_id"/>
                <field name="formateur_id"/>
                <field name="state"/>
                <filter string="Brouillon" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmée" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Annulée" name="cancel" domain="[('state','=','cancel')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Formation" name="group_formation" context="{'group_by': 'formation_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Participant" name="group_participant" context="{'group_by': 'participant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_formation_inscriptions" model="ir.actions.act_window">
        <field name="name">Inscriptions</field>
        <field name="res_model">gestion.formation.inscription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_formations_inscriptions" 
              name="Inscriptions" 
              parent="menu_gestion_formations" 
              sequence="40"
              action="action_formation_inscriptions"/>
</odoo>
